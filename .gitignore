# local dev data (portable MariaDB) and secrets - never commit
/data/
node_modules/
.env
.env.local
api/.env
*.log
.DS_Store

# Build outputs (web/dist, api/dist) ARE committed on purpose:
# cPanel Git deploys them straight to the server, so no build runs on the host.

# Local archives / snapshots (never commit these, they bloat the repo)
*.zip
!deploy/klippy-api.zip
!deploy/klippy-web.zip
!klippyextension.zip

# Written by the cPanel deploy on the server; never committed.
api/deployed.json

# Throwaway probe and verification scripts. An underscore prefix marks a file as
# temporary: agents and repros create them in api/tests while running, and a
# `git add -A` mid-run once swept four of them into a commit.
api/tests/_*
